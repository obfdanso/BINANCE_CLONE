# Copy this file to .env and fill in real values. .env is gitignored.
# Nothing here is a working credential.

SERVER_PORT=8080

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/bitby_db
DB_USER=bitby_user
DB_PASSWORD=change-me

# --- Basic auth for actuator/admin endpoints ---
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=change-me

# --- Email (Gmail needs an App Password, not the account password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-me


# --- JWT signing key ---
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me
JWT_EXPIRATION_MS=86400000

# --- Paystack (dashboard -> Settings -> API Keys) ---
PAYSTACK_SECRET_KEY=sk_test_change_me
PAYSTACK_PUBLIC_KEY=pk_test_change_me

# --- Optional: log every SQL statement (very verbose) ---
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
